#!/usr/bin/env python3
import os

from SCons.Script import Environment, Glob, SConscript

# PEAK's native gameplay layer uses the official Godot 4.7 C++ bindings.
local_env = Environment(tools=["default"], PLATFORM="")
env = SConscript(
    "godot-cpp/SConstruct",
    {"api_version": "4.7", "env": local_env},
)

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Keep the generated binary inside a staging package that can be copied into
# the Godot project without putting compiled binaries in Git.
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
library_name = (
    env.subst("$SHLIBPREFIX")
    + "peak_native"
    + suffix
    + env.subst("$SHLIBSUFFIX")
)
output_dir = os.path.join(
    "package", "addons", "peak_native", "bin", env["platform"]
)
os.makedirs(output_dir, exist_ok=True)

library = env.SharedLibrary(
    os.path.join(output_dir, library_name),
    source=sources,
)

Default(library)
