[configuration]
entry_symbol = "peak_native_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
android.debug.arm64 = "res://addons/peak_native/bin/android/libpeak_native.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/peak_native/bin/android/libpeak_native.android.template_release.arm64.so"
linux.debug.x86_64 = "res://addons/peak_native/bin/linux/libpeak_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/peak_native/bin/linux/libpeak_native.linux.template_release.x86_64.so"
